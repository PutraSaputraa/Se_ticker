rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validAccount() {
        let data = request.resource.data;
        return data.keys().hasAll(['watchlist', 'history', 'updatedAt'])
          && data.keys().hasOnly(['watchlist', 'history', 'updatedAt', 'journal', 'capital', 'currency', 'wallet'])
          && data.watchlist is list
          && data.history is list
          && data.history.size() <= 5
          && data.get('journal', []) is list
          && data.get('capital', 0) is number
          && data.get('capital', 0) >= 0
          && data.get('currency', 'USD') in ['USD', 'IDR', 'USDT']
          && data.get('wallet', []) is list
          && data.updatedAt == request.time;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && validAccount();
      allow update: if isOwner() && validAccount()
        && request.resource.data.get('wallet', []).size() >= resource.data.get('wallet', []).size();
    }

    match /journalSetups/{setupId} {
      function owns(data) {
        return request.auth != null && data.uid == request.auth.uid;
      }

      function validSetup() {
        let data = request.resource.data;
        return data.keys().hasOnly(['uid', 'pair', 'market', 'date', 'side', 'type',
            'timeframe', 'setup', 'thesis', 'positionCents', 'limitPrice', 'stopLoss', 'takeProfit',
            'rewardMultiple', 'quoteCurrency', 'triggerAbove', 'entryTimeZone', 'createdAt'])
          && data.pair is string && data.pair.size() <= 32
          && data.pair.matches('^[A-Z0-9^][A-Z0-9.=-]*$')
          && data.market in ['us', 'hk', 'jp', 'ks', 'kq', 'tw', 'two', 'crypto', 'id', 'ss', 'sz']
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.side in ['long', 'short']
          && data.type in ['spot', 'futures']
          && data.timeframe in ['Daily', 'Weekly', '4H']
          && data.setup is string && data.setup.size() > 0 && data.setup.size() <= 40
          && data.thesis is string && data.thesis.size() <= 2000
          && data.positionCents is int && data.positionCents > 0 && data.positionCents <= 999999999999900
          && data.limitPrice is number && data.limitPrice > 0
          && data.stopLoss is number && data.stopLoss > 0
          && data.takeProfit is number && data.takeProfit > 0
          && (data.side == 'long'
            ? data.stopLoss < data.limitPrice && data.takeProfit > data.limitPrice
            : data.takeProfit < data.limitPrice && data.stopLoss > data.limitPrice)
          && (data.rewardMultiple == null || data.rewardMultiple in [2, 3, 4])
          && data.quoteCurrency is string && data.quoteCurrency.size() > 0 && data.quoteCurrency.size() <= 12
          && data.triggerAbove is bool
          && data.entryTimeZone is string && data.entryTimeZone.size() <= 80
          && data.createdAt == request.time;
      }

      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && validSetup();
    }
  }
}
